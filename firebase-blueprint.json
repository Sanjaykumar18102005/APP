{
  "entities": {
    "User": {
      "title": "User",
      "description": "Optimized user profile data in PromptGlow",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "plan": { "type": "string" },
        "totalPromptsGenerated": { "type": "integer" },
        "totalChats": { "type": "integer" },
        "totalVisionAnalyzed": { "type": "integer" },
        "createdAt": { "type": "integer" },
        "createdAtISO": { "type": "string", "format": "date-time" },
        "createdAtFormatted": { "type": "string" },
        "lastActiveAt": { "type": "integer" },
        "lastActiveAtISO": { "type": "string", "format": "date-time" },
        "lastActiveAtFormatted": { "type": "string" },
        "preferences": { "type": "object" },
        "apiStatus": { "type": "object" }
      },
      "required": ["uid", "createdAt", "createdAtISO", "lastActiveAt"]
    },
    "Prompt": {
      "title": "Prompt",
      "description": "Saved refined prompts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdAtISO": { "type": "string", "format": "date-time" },
        "createdAtFormatted": { "type": "string" }
      },
      "required": ["userId", "title", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Optimized user profile documents"
    },
    "/prompts/{promptId}": {
      "schema": { "$ref": "#/entities/Prompt" },
      "description": "Saved prompts created by users"
    }
  }
}
