{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "esnext"
    ],
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "*": [
        "node_modules/*",
        "../node_modules/*"
      ]
    },
    "typeRoots": [
      "node_modules/@types",
      "../node_modules/@types"
    ],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*",
    "App.tsx"
  ]
}
