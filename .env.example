# Gemini API (Required - Server-Side Only)
# Securely stored as a secret in AI Studio or your deployment platform (Vercel, Netlify, etc.)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Firebase Configuration (Optional - Falls back to local/injected config if empty)
# Necessary if deploying externally to Vercel/Netlify and overriding local config assets
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
